DATABASE_URL=postgresql://postgres:your_password@localhost:5432/coffeehub
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256

# CoffeeHub has exactly one administrator. Keep these values in backend/.env.
ADMIN_NAME=CoffeeHub Administrator
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace-with-your-strong-admin-password

# Twilio WhatsApp Sandbox
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_ADMIN_NUMBER=+91XXXXXXXXXX
