DATABASE_URL=postgresql://postgres:your_password@localhost:5432/coffeehub
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256

# Used only when the database has no administrator yet.
# CoffeeHub creates exactly one administrator from these values.
ADMIN_NAME=CoffeeHub Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password
